# TradeCore deployment-only environment.
#
# Copy to `.env.deploy`, set mode 0600, and fill values through the VPS secret
# process. Stage two loads this file; PM2 and the API do not. Never commit the
# real file or paste its URLs into logs, issues, or pull requests.

# Dedicated owner connection for schema migration and security verification.
DATABASE_MIGRATION_URL=postgres://tradecore_owner:password@host:5432/tradecore

# One-time only while the database is still owned by the legacy `tradecore`
# role. Must be authorized to REASSIGN OWNED and ALTER ROLE/DATABASE. Remove
# this value after the role migration verifies successfully.
DATABASE_BOOTSTRAP_URL=postgres://database_admin:password@host:5432/tradecore

TRADECORE_DATABASE_NAME=tradecore
TRADECORE_LEGACY_ROLE=tradecore
TRADECORE_DATABASE_OWNER_ROLE=tradecore_owner
TRADECORE_RUNTIME_ROLE=tradecore_runtime

# Runtime entry authority is fail-closed during deployment. The runtime .env
# should also set this explicitly; false requires an operator-reviewed change.
AUTOPILOT_GLOBAL_SUSPENDED=true

# The current seven-engine workload requires at least this bounded window.
READINESS_TIMEOUT_SECONDS=180
LIVENESS_TIMEOUT_SECONDS=60
HEALTH_INTERVAL_SECONDS=2
HEALTH_REQUEST_TIMEOUT_SECONDS=5
